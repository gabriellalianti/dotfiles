#!/usr/bin/env bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"
export CONFIG_DIR
source "$CONFIG_DIR/colors.sh"

sketchybar --bar \
  position=top \
  height=36 \
  y_offset=2 \
  margin=8 \
  corner_radius=12 \
  color="$BAR_COLOR" \
  border_color="$BAR_BORDER_COLOR" \
  border_width=1 \
  blur_radius=20 \
  padding_left=8 \
  padding_right=8 \
  notch_width=230

sketchybar --default \
  background.height=26 \
  background.color="$SURFACE_COLOR" \
  background.corner_radius=8 \
  background.padding_left=4 \
  background.padding_right=4 \
  icon.padding_left=8 \
  icon.padding_right=8 \
  icon.background.height=26 \
  icon.background.corner_radius=8 \
  label.padding_left=8 \
  label.padding_right=8 \
  icon.font="$FONT_DISPLAY" \
  label.font="$FONT_TEXT"

ITEMS=(
  aerospace
  front_app
  clock
  battery
  volume
  cpu
)
for item in "${ITEMS[@]}"; do
  source "$CONFIG_DIR/items/$item.sh"
done

# Keep the clock updated from the persistent native helper. This avoids
# spawning a shell and `date` process every second.
pkill -x sketchybar-clock 2>/dev/null
CLOCK_HELPER="$CONFIG_DIR/helpers/sketchybar-clock"
if [[ -x "$CLOCK_HELPER" ]]; then
  "$CLOCK_HELPER" &
else
  echo "Clock helper has not been compiled; run: make -C \"$CONFIG_DIR/helpers\"" >&2
fi

sketchybar --update
